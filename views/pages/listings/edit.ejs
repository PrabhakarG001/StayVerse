<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-lg-8 col-md-10 col-12">
    <div class="card border shadow-sm p-4 p-md-5 rounded-4 bg-white mt-3">
      <h3 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-pen-to-square me-2 text-rose"></i>Edit your Listing</h3>

      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold text-secondary">Title</label>
          <input id="title" name="listing[title]" value="<%= listing.title %>" type="text" class="form-control form-control-lg rounded-3" required>
          <div class="invalid-feedback">Please enter a valid title.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold text-secondary">Description</label>
          <textarea id="description" name="listing[description]" rows="4" class="form-control rounded-3" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description.</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold text-secondary">Image Link</label>
          <input id="image" name="listing[image]" value="<%= listing.image && listing.image.url ? listing.image.url : '' %>" type="url" class="form-control rounded-3">
          <small class="text-muted text-xs">Specify a web address for the property image.</small>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold text-secondary">Gallery Image URLs (Optional - Add up to 4 more images)</label>
          <div class="row g-2">
            <% for (let i = 0; i < 4; i++) { 
              const val = (listing.images && listing.images[i] && listing.images[i].url) ? listing.images[i].url : '';
            %>
              <div class="col-6 col-md-3">
                <input name="listing[galleryImages][<%= i %>]" value="<%= val %>" placeholder="Gallery Image <%= i + 1 %> URL" type="url" class="form-control rounded-3 py-2 fs-6">
              </div>
            <% } %>
          </div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-6 col-12">
            <label for="price" class="form-label fw-semibold text-secondary">Price per night (Rs.)</label>
            <div class="input-group">
              <span class="input-group-text rounded-start-3">Rs.</span>
              <input id="price" name="listing[price]" value="<%= listing.price %>" type="number" class="form-control rounded-end-3" min="0" required>
              <div class="invalid-feedback">Please specify a price (must be 0 or higher).</div>
            </div>
          </div>

          <div class="mb-3 col-md-6 col-12">
            <label for="category" class="form-label fw-semibold text-secondary">Category</label>
            <select id="category" name="listing[category]" class="form-select rounded-3" required>
              <% 
              const categories = ["Trending", "Beachfront", "Iconic Cities", "Mountains", "Castles", "Pools", "Camping", "Lakefront", "Jungle", "Historic"];
              for (let cat of categories) {
                const isSelected = listing.category === cat;
              %>
                <option value="<%= cat %>" <%= isSelected ? "selected" : "" %>><%= cat %></option>
              <% } %>
            </select>
            <div class="invalid-feedback">Please select a category.</div>
          </div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-6 col-12">
            <label for="location" class="form-label fw-semibold text-secondary">City / Location</label>
            <input id="location" name="listing[location]" value="<%= listing.location %>" type="text" class="form-control rounded-3" required>
            <div class="invalid-feedback">Please enter the location.</div>
          </div>

          <div class="mb-3 col-md-6 col-12">
            <label for="country" class="form-label fw-semibold text-secondary">Country</label>
            <input id="country" name="listing[country]" value="<%= listing.country %>" type="text" class="form-control rounded-3" required>
            <div class="invalid-feedback">Please enter the country.</div>
          </div>
        </div>

        <div class="d-grid mt-4">
          <button class="btn btn-rose btn-lg rounded-pill py-2.5 fw-bold">
            <i class="fa-solid fa-check-double me-2"></i>Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
