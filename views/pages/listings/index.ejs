<!-- Link to index styling -->
<link rel="stylesheet" href="/css/listings-index.css">

<!-- Configure and initialize listings-index via hybrid search helper -->
<script id="listings-index-config" type="application/json">
  {
    "activeFilter": "<%= filter %>",
    "foreignCities": <%- JSON.stringify(foreignCities.map(c => ({ city: c.city, id: c.id }))) %>,
    "indianCities": <%- JSON.stringify(indianCities.map(c => ({ city: c.city, id: c.id }))) %>
  }
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const configEl = document.getElementById('listings-index-config');
    if (configEl && typeof initListingsIndex === 'function') {
      initListingsIndex(JSON.parse(configEl.textContent));
    }
    
    // Prefetch logic on hover for hotel cards
    document.addEventListener('mouseover', function(e) {
      const cardLink = e.target.closest('.hotel-slide a, a.hotel-card');
      if (cardLink && cardLink.href && !cardLink.href.includes('javascript:')) {
        const url = cardLink.href;
        if (!document.querySelector(`link[rel="prefetch"][href="${url}"]`)) {
          const prefetchLink = document.createElement('link');
          prefetchLink.rel = 'prefetch';
          prefetchLink.href = url;
          document.head.appendChild(prefetchLink);
        }
      }
    });
  });
</script>
