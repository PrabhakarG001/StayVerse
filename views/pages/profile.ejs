<% layout('layouts/boilerplate') %>

<div class="container pb-5">
    <div class="row justify-content-center mt-md-4">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="profile-header text-center mb-4 pt-4">
                <div class="profile-avatar mx-auto mb-3" style="width: 100px; height: 100px; border-radius: 50%; background-color: #222; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 40px; font-weight: 600;">
                    <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
                </div>
                <h2 class="fw-bold mb-1"><%= currentUser.name %></h2>
                <p class="text-muted mb-3" style="text-transform: capitalize;"><%= currentUser.role === 'user' ? 'Guest / User' : currentUser.role %></p>
                <button class="btn btn-outline-dark btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                    Edit Profile
                </button>
            </div>

            <div class="profile-sections mt-4">
                <div class="row g-3 d-md-none mb-3">
                    <div class="col-6">
                        <div class="card border-0 rounded-4 shadow-sm h-100 p-3 position-relative" onclick="handleProtectedAction(function(){ window.location.href='/bookings?tab=past' })" style="cursor: pointer;">
                            <span class="badge bg-danger position-absolute top-0 end-0 mt-2 me-2 rounded-pill shadow-sm" style="font-size: 0.6rem;">NEW</span>
                            <div class="text-center mb-2 mt-2">
                                <img src="/images/suitcase_3d.png" alt="Past Trips" style="width: 80px; height: 80px; object-fit: contain; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));">
                            </div>
                            <h6 class="text-center fw-bold mt-3 mb-0">Past trips</h6>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card border-0 rounded-4 shadow-sm h-100 p-3 position-relative" onclick="handleProtectedAction(function(){ window.location.href='/connections' })" style="cursor: pointer;">
                            <span class="badge bg-danger position-absolute top-0 end-0 mt-2 me-2 rounded-pill shadow-sm" style="font-size: 0.6rem;">NEW</span>
                            <div class="text-center mb-2 mt-2">
                                <img src="/images/connections.png" onerror="this.src='https://via.placeholder.com/80/eef1f6/717171?text=3D+Group'" alt="Connections" style="width: 80px; height: 80px; object-fit: contain; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));">
                            </div>
                            <h6 class="text-center fw-bold mt-3 mb-0">Connections</h6>
                        </div>
                    </div>
                </div>

                <!-- Become a Host full width -->
                <div class="card border-0 rounded-4 shadow-sm mb-4 d-md-none position-relative overflow-hidden" onclick="window.location.href='/auth/login-host'" style="cursor: pointer; background: linear-gradient(135deg, #ff385c 0%, #d90b36 100%);">
                    <div class="d-flex align-items-center p-3">
                        <div class="host-avatar me-3" style="width: 90px; flex-shrink: 0;">
                            <img src="/images/host.png" onerror="this.src='https://via.placeholder.com/90x120/ffffff/ff385c?text=3D+Girl'" alt="Host" style="width: 100%; height: auto; object-fit: contain; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.2)); transform: scale(1.2) translateY(10px);">
                        </div>
                        <div class="text-white">
                            <h6 class="fw-bold mb-1">Become a Host</h6>
                            <p class="small mb-0 opacity-75">It’s easy to start hosting and earn extra income.</p>
                        </div>
                    </div>
                </div>

                <!-- Desktop / Original List for Account Settings -->
                <div class="list-group list-group-flush border-top border-bottom rounded-0 mt-4">
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-0">
                        <div>
                            <i class="fa-solid fa-gear me-3 text-muted"></i>
                            <span class="fw-medium">Account Settings</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted small"></i>
                    </a>
                </div>

                <div class="mt-4 text-center">
                    <a href="/auth/logout" class="text-danger text-decoration-none fw-bold">Log out</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="editProfileModalLabel">Edit Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form action="/profile/edit" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="name" class="form-label text-muted small">Full Name</label>
                <input type="text" class="form-control form-control-lg rounded-3" id="name" name="name" value="<%= currentUser.name %>" required>
                <div class="invalid-feedback">Please enter your name.</div>
            </div>
            <div class="mb-4">
                <label for="password" class="form-label text-muted small">New Password (leave blank to keep current)</label>
                <input type="password" class="form-control form-control-lg rounded-3" id="password" name="password" placeholder="Enter new password">
            </div>
            <button type="submit" class="btn btn-dark w-100 rounded-3 py-2 fw-medium">Save Changes</button>
        </form>
      </div>
    </div>
  </div>
</div>
