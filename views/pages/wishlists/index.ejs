<% layout('layouts/boilerplate') %>




<div class="container mt-5 mb-5 px-4" style="max-width: 1400px;">
  <h2 class="fw-bold mb-4" style="font-size: 2rem;">Your Wishlists</h2>
  
  <div id="wishlist-container" class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-7 row-cols-xl-7 row-cols-xxl-7 g-2 g-md-4">
    <!-- Cards will be injected here via JS -->
  </div>
  
  <div id="empty-state" class="wishlist-empty" style="display: none;">
    <i class="fa-regular fa-heart"></i>
    <h3 class="fw-bold">No saved stays yet</h3>
    <p class="text-secondary mt-2 mb-4">As you search, click the heart icon to save your favorite places and experiences to a wishlist.</p>
    <a href="/" class="btn btn-dark fw-bold px-4 py-3" style="border-radius: 12px; font-size: 1.1rem;">Start exploring</a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    renderWishlists();
  });
  
  async function renderWishlists() {
    const container = document.getElementById('wishlist-container');
    const emptyState = document.getElementById('empty-state');
    
    try {
      const response = await fetch('/api/wishlists');
      if (response.status === 401) {
        window.location.href = "/auth/login-user";
        return;
      }
      
      const wishlists = await response.json();
      localStorage.setItem('stayverse_wishlists', JSON.stringify(wishlists));
      
      if (wishlists.length === 0) {
        container.style.display = 'none';
        emptyState.style.display = 'flex';
        return;
      }
      
      container.style.display = 'flex';
      emptyState.style.display = 'none';
      
      container.innerHTML = wishlists.map(hotel => {
        let badgeHtml = '';
        if (hotel.isPremium === true || hotel.isPremium === 'true') {
          badgeHtml = `
            <div class="badge-category-overlay d-flex align-items-center">
              <i class="fa-solid fa-gem text-rose me-1" style="font-size:0.6rem"></i> Guest favourite
            </div>`;
        }
        
        return `
          <div class="col" id="wishlist-card-${hotel.propertyId}">
            <a href="/hotels/show/${hotel.propertyId}" class="text-decoration-none text-dark d-block h-100 hotel-card">
              <div class="card border-0 h-100 bg-transparent hotel-card-hover rounded-4 position-relative pb-3">
                <div class="position-relative overflow-hidden rounded-4 mb-2" style="aspect-ratio: 1 / 1; width: 100%;">
                  <img src="${hotel.imageUrl}" class="w-100 h-100 object-fit-cover" alt="Hotel Image" loading="lazy">
                  
                  ${badgeHtml}
                  
                  <div class="position-absolute top-0 end-0 m-3" style="z-index: 10;">
                    <i class="fa-solid fa-heart fs-5 text-danger heart-wishlist-icon" 
                       data-id="${hotel.propertyId}" 
                       style="text-shadow: 0 1px 3px rgba(0,0,0,0.5); cursor: pointer;" 
                       onclick="removeFromWishlist(event, '${hotel.propertyId}')"></i>
                  </div>
                </div>
                <div class="pt-1 pe-1">
                  <div class="d-flex justify-content-between align-items-start mb-1">
                    <h6 class="fw-bold text-dark mb-0 pe-2 text-truncate" style="font-size: 0.98rem; line-height: 1.3; max-width: 85%;">${hotel.name}</h6>
                    <div class="ms-1 d-flex align-items-center flex-shrink-0 mt-1">
                      <i class="fa-solid fa-star me-1" style="font-size: 0.75rem; color: #222;"></i>
                      <span style="font-size: 0.9rem; color: #222; font-weight: 600;">${hotel.rating}</span>
                    </div>
                  </div>
                  <p class="text-secondary mb-1 text-truncate" style="font-size: 0.9rem; line-height: 1.4;">${hotel.location}</p>
                  <div class="d-flex align-items-center mt-1 pb-1">
                    <span class="fw-bold text-dark" style="font-size: 0.98rem;">${hotel.price}</span>
                    <span class="text-dark" style="font-size: 0.9rem;">&nbsp;for 2 nights</span>
                  </div>
                </div>
                <i class="fa-solid fa-chevron-down scroll-indicator"></i>
              </div>
            </a>
          </div>
        `;
      }).join('');
    } catch (err) {
      console.error("Wishlist render error:", err);
      container.style.display = 'none';
      emptyState.style.display = 'flex';
    }
  }
  
  async function removeFromWishlist(event, propertyId) {
    event.preventDefault();
    event.stopPropagation();
    
    try {
      const response = await fetch('/api/wishlists/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ propertyId })
      });
      
      if (response.ok) {
        const data = await response.json();
        localStorage.setItem('stayverse_wishlists', JSON.stringify(data.wishlist));
        
        // Remove element from DOM
        const card = document.getElementById(`wishlist-card-${propertyId}`);
        if (card) {
          card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.9)';
          setTimeout(() => {
            card.remove();
            if (data.wishlist.length === 0) {
              renderWishlists(); // Show empty state
            }
          }, 300);
        }
      }
    } catch (err) {
      console.error("Wishlist remove error:", err);
    }
  }
</script>
