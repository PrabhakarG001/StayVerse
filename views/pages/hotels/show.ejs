<% layout("/layouts/boilerplate") %>

<% 
// Helper to generate consistent random data based on propertyId
const seed = parseInt(hotel.propertyId) || 12345;
const random = (min, max) => Math.floor(Math.abs((seed * 9301 + 49297) % 233280) / 233280 * (max - min + 1)) + min;
// Realistic INR price between ₹3,000 and ₹18,000
const price = hotel.price || random(3000, 18000);
const currency = hotel.currency || 'INR';
const checkin = hotel.checkin || '14:00';
const checkout = hotel.checkout || '12:00';
const distance = hotel.distanceToCityCenter || '';

const allAmenities = [
  { name: "Free Fast WiFi", icon: "fa-wifi" },
  { name: "Swimming Pool", icon: "fa-water-ladder" },
  { name: "Free Parking", icon: "fa-square-parking" },
  { name: "Air Conditioning", icon: "fa-snowflake" },
  { name: "Restaurant", icon: "fa-utensils" },
  { name: "Room Service", icon: "fa-bell-concierge" },
  { name: "Fitness Center", icon: "fa-dumbbell" },
  { name: "Spa & Wellness", icon: "fa-spa" },
  { name: "Bar/Lounge", icon: "fa-martini-glass" },
  { name: "Airport Shuttle", icon: "fa-van-shuttle" }
];

// Pick 6 pseudo-random amenities safely
const amenities = [];
let tempAmenities = [...allAmenities];
for(let i=0; i<6; i++) {
  const index = Math.abs((seed * (i + 7)) ^ 0x555555) % tempAmenities.length;
  amenities.push(tempAmenities.splice(index, 1)[0]);
}

const roomTypes = [
  { name: "Standard Room", desc: "1 Queen Bed, City View", extra: 0 },
  { name: "Deluxe Room", desc: "1 King Bed, Balcony", extra: 2500 },
  { name: "Executive Suite", desc: "1 King Bed, Living Area, Premium View", extra: 6000 }
];

// Location-based default reviews
const indianCitiesList = ['goa','mumbai','delhi','jaipur','bangalore','chennai','kolkata','pune','hyderabad','agra','udaipur','kochi','manali','shimla','rishikesh','varanasi','amritsar','gurugram','leh','hospet','hampi','kerala'];
const foreignCitiesList = ['new york', 'los angeles', 'london', 'dubai', 'paris', 'rome', 'amsterdam', 'tokyo', 'singapore', 'bangkok', 'sydney', 'toronto', 'istanbul', 'cape town', 'rio de janeiro', 'bali', 'santorini', 'maldives', 'phuket', 'swiss alps', 'iceland', 'cappadocia', 'athens', 'venice', 'seoul', 'marrakech', 'reykjavik', 'cairo', 'barcelona'];
const cityLower = (hotel.city || '').toLowerCase().trim();
let isIndiaFallback = false;
if (foreignCitiesList.includes(cityLower)) {
  isIndiaFallback = false;
} else if (indianCitiesList.includes(cityLower)) {
  isIndiaFallback = true;
} else {
  isIndiaFallback = hotel.country ? hotel.country.toLowerCase().trim() === 'india' : false;
}
const defaultReviews = isIndiaFallback ? [
  { user: "Rahul S.", rating: "4.8", comment: "Absolutely loved our stay! The staff was incredibly welcoming and the room was spotless. Will definitely return.", date: "June 2026" },
  { user: "Priya M.", rating: "4.5", comment: "Great location and fantastic amenities. The breakfast buffet had so many options. Highly recommend!", date: "May 2026" },
  { user: "Amit K.", rating: "4.2", comment: "Very good hotel. Clean rooms and prompt room service. The pool area is very relaxing.", date: "April 2026" }
] : [
  { user: "John Smith", rating: "4.8", comment: "Absolutely loved our stay! The staff was incredibly welcoming and the room was spotless. Will definitely return.", date: "June 2026" },
  { user: "Emily Brown", rating: "4.5", comment: "Great location and fantastic amenities. The breakfast buffet had so many options. Highly recommend!", date: "May 2026" },
  { user: "Carlos Rivera", rating: "4.2", comment: "Very good hotel. Clean rooms and prompt room service. The pool area is very relaxing.", date: "April 2026" }
];
const reviewsToDisplay = defaultReviews;
%>

<div class="row mt-4">
  <!-- Title & Info Section -->
  <div class="col-12 mb-4">
    <h2 class="text-dark fw-bold mb-1"><%= hotel.name %></h2>
    <p class="text-secondary mb-2 fs-6">
      <i class="fa-solid fa-location-dot text-rose me-1"></i><%= hotel.area ? hotel.area + ', ' : '' %><%= hotel.city %>
      <% if(hotel.starRating && hotel.starRating >= 1) { %>
        <% const propTypeRaw = hotel.accommodationType || hotel.propertyType || 'Hotel'; %>
        <% let propType = typeof propTypeRaw === 'object' ? (propTypeRaw.name || 'Hotel') : propTypeRaw; %>
        <% if (propType.toLowerCase() === 'apartment') propType = 'Flat'; %>
        <span class="mx-2">&middot;</span>
        <span class="fw-bold text-dark"><i class="fa-solid fa-star text-warning me-1"></i><%= Math.floor(hotel.starRating) %> Star <%= propType %></span>
      <% } %>
      <% if(hotel.reviewScore) { %>
        <span class="mx-2">&middot;</span>
        <span class="fw-semibold text-dark"><i class="fa-solid fa-thumbs-up text-primary me-1"></i><%= hotel.reviewScore %> Rating (<%= hotel.reviewCount || 0 %> reviews)</span>
      <% } %>
    </p>
    
    <!-- Image Gallery -->
    <div class="position-relative my-3 rounded-4 overflow-hidden show-gallery-wrapper">
      <% 
      let images = [];
      let mainUrl = 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80';
      if (hotel.images && hotel.images.length > 0) {
        images = hotel.images;
      } else {
        images.push(mainUrl);
      }
      
      while(images.length < 4) {
        images.push("https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=800&q=60");
      }
      %>
      <!-- Mobile view: Swipeable Horizontal Carousel -->
      <div class="d-md-none position-relative">
        <div class="show-mobile-carousel d-flex overflow-auto flex-nowrap hide-scrollbar" style="scroll-snap-type: x mandatory; scroll-behavior: smooth; height: 35vh; min-height: 250px;">
          <% images.forEach((img, idx) => { %>
            <div class="w-100 h-100 flex-shrink-0" style="scroll-snap-align: start; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#imageGalleryModal">
              <img src="<%= img %>" class="w-100 h-100 object-fit-cover" alt="Hotel Image <%= idx + 1 %>">
            </div>
          <% }) %>
        </div>
        
        <!-- Three dot pagination indicator -->
        <div class="show-carousel-dots d-flex justify-content-center gap-1.5 position-absolute bottom-0 start-50 translate-middle-x mb-3" style="z-index: 5;">
          <% images.forEach((img, idx) => { %>
            <span class="show-dot <%= idx === 0 ? 'active' : '' %>" style="width: 6px; height: 6px; border-radius: 50%; background: rgba(255, 255, 255, 0.5); transition: all 0.2s ease;"></span>
          <% }) %>
        </div>
      </div>

      <!-- Desktop view: Standard Grid -->
      <div class="d-none d-md-flex row g-2" style="height: 50vh; min-height: 300px; max-height: 450px;">
        <!-- Main Image (Left) -->
        <div class="col-md-6 h-100">
          <div class="h-100 position-relative overflow-hidden rounded-start">
            <img src="<%= images[0] %>" class="w-100 h-100 object-fit-cover photo-zoom" alt="main_image" loading="lazy" style="transition: all 0.3s ease; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#imageGalleryModal">
          </div>
        </div>
        <!-- Sub Images (Right) -->
        <div class="col-md-6 h-100">
          <div class="row h-100 g-2">
            <!-- Top Full Width -->
            <div class="col-12 h-50">
              <div class="h-100 overflow-hidden position-relative rounded-end-top">
                <img src="<%= images[1] %>" class="w-100 h-100 object-fit-cover photo-zoom" alt="sub_image_1" loading="lazy" style="transition: all 0.3s ease; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#imageGalleryModal">
              </div>
            </div>
            <!-- Bottom Left -->
            <div class="col-6 h-50">
              <div class="h-100 overflow-hidden position-relative">
                <img src="<%= images[2] %>" class="w-100 h-100 object-fit-cover photo-zoom" alt="sub_image_2" loading="lazy" style="transition: all 0.3s ease; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#imageGalleryModal">
              </div>
            </div>
            <!-- Bottom Right -->
            <div class="col-6 h-50">
              <div class="h-100 overflow-hidden position-relative rounded-end-bottom">
                <img src="<%= images[3] %>" class="w-100 h-100 object-fit-cover photo-zoom" alt="sub_image_3" loading="lazy" style="transition: all 0.3s ease; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#imageGalleryModal">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Left: Details & Amenities -->
  <div class="col-lg-7 col-12 pe-lg-5">
    
    <div class="details-card mb-4 pb-4 border-bottom">
      <h4 class="text-dark fw-bold mb-3">About this hotel</h4>
      <div class="mb-3">
        <span class="badge bg-light text-dark border me-2"><i class="fa-solid fa-clock me-1"></i>Check-in: <%= checkin %></span>
        <span class="badge bg-light text-dark border me-2"><i class="fa-solid fa-clock me-1"></i>Check-out: <%= checkout %></span>
        <% if(distance) { %>
          <span class="badge bg-light text-dark border"><i class="fa-solid fa-location-arrow me-1"></i><%= distance %></span>
        <% } %>
      </div>
      <p class="text-secondary leading-relaxed" style="white-space: pre-line; line-height: 1.7;">
        Experience world-class service at <%= hotel.name %>. Located in <%= hotel.address %>, this <%= hotel.starRating %>-star luxury property offers unparalleled comfort and convenience. 
        
        Guests can enjoy state-of-the-art facilities, beautifully designed rooms with stunning views, and exquisite dining options prepared by award-winning chefs. Whether you're traveling for business or leisure, <%= hotel.name %> provides the perfect sanctuary for a memorable stay.
      </p>
    </div>

    <!-- Amenities Section -->
    <div class="amenities-section mb-4 pb-4 border-bottom">
      <h4 class="text-dark fw-bold mb-4">What this place offers</h4>
      <div class="row g-3">
        <% amenities.forEach(amenity => { %>
          <div class="col-6 d-flex align-items-center mb-2">
            <i class="fa-solid <%= amenity.icon %> fs-4 me-3 text-secondary" style="width: 30px;"></i>
            <span class="fs-6 text-dark"><%= amenity.name %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Room Types Section -->
    <div class="room-types-section mb-4 pb-4 border-bottom">
      <h4 class="text-dark fw-bold mb-4">Available Room Types</h4>
      <div class="d-flex flex-column gap-3">
        <% roomTypes.forEach(room => { %>
          <div class="card border rounded-4 p-3 shadow-sm bg-white">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="fw-bold text-dark mb-1"><%= room.name %></h6>
                <p class="text-secondary mb-0 small"><i class="fa-solid fa-bed me-2 text-muted"></i><%= room.desc %></p>
              </div>
              <div class="text-end">
                <span class="fw-bold text-dark fs-5"><% if(room.extra === 0) { %>Base<% } else { %>+<span class="price-val" data-inr="<%= room.extra %>">₹<%= room.extra.toLocaleString('en-IN') %></span><% } %></span>
                <% if(room.extra > 0) { %><p class="text-muted mb-0" style="font-size: 0.75rem;">/ night</p><% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Reviews Section -->
    <div class="reviews-section mb-4 pb-4 border-bottom">
      <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-star fs-3 text-dark me-2"></i>
        <h4 class="text-dark fw-bold m-0"><%= hotel.reviewScore ? (hotel.reviewScore / 2).toFixed(1) : 4.5 %> / 5.0 · <%= hotel.reviewCount || 120 %> reviews</h4>
      </div>
      <div class="row gx-4 gy-4 mt-1" id="reviewsContainer">
        <% reviewsToDisplay.forEach(review => { %>
          <div class="col-md-6">
            <div class="d-flex align-items-center mb-2">
              <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 45px; height: 45px; font-size: 1.2rem;">
                <%= review.user.charAt(0) %>
              </div>
              <div>
                <h6 class="fw-bold text-dark mb-0"><%= review.user %></h6>
                <small class="text-muted"><%= review.date %></small>
              </div>
            </div>
            <div class="mb-2">
              <% for(let i=1; i<=5; i++) { %>
                <i class="fa-solid fa-star <%= i <= Math.round(review.rating) ? 'text-warning' : 'text-muted opacity-25' %>" style="font-size: 0.85rem;"></i>
              <% } %>
            </div>
            <p class="text-secondary" style="font-size: 0.95rem; line-height: 1.5;"><%= review.comment %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Interactive Map Section -->
    <div class="map-section mb-5">
      <h4 class="text-dark fw-bold mb-4">Where you'll be</h4>
      <p class="text-secondary mb-3"><%= hotel.area ? hotel.area + ', ' : '' %><%= hotel.city %>, <%= hotel.country || 'India' %></p>
      <div id="map" class="rounded-4 border shadow-sm" style="height: 50vh; min-height: 300px; max-height: 400px; width: 100%; z-index: 1;"></div>
    </div>



  </div>

  <!-- Right: Booking Form -->
  <div class="col-lg-5 col-12 mt-lg-0 mt-4 position-relative">
    <div class="card border shadow-lg rounded-4 p-4 mb-4 bg-white sticky-card" style="top: 100px; z-index: 10;">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0 text-dark">
          <span class="price-val" data-inr="<%= price %>"><%= currency === 'INR' ? '₹' : (currency + ' ') %><%= price.toLocaleString('en-IN') %></span> <span class="fw-normal text-muted fs-6">/ night</span>
        </h3>
        <% if(hotel.reviewScore) { %>
          <span class="text-dark fw-semibold" style="font-size: 0.9rem;">
            <i class="fa-solid fa-star me-1 text-warning small"></i><%= hotel.reviewScore %>
            <span class="text-muted text-decoration-underline ms-1">(<%= hotel.reviewCount || 0 %>)</span>
          </span>
        <% } %>
      </div>
      
      <form id="internalBookingForm" class="booking-form">
        <div class="border rounded-4 mb-3">
          <div class="d-flex border-bottom">
            <div class="w-50 p-2 border-end form-group-custom">
              <label class="text-uppercase fw-bold text-muted" style="font-size: 0.65rem; cursor: pointer;">Check-in</label>
              <input type="date" id="checkin_date" class="form-control border-0 p-0 shadow-none text-dark fw-semibold bg-transparent" required>
            </div>
            <div class="w-50 p-2 form-group-custom">
              <label class="text-uppercase fw-bold text-muted" style="font-size: 0.65rem; cursor: pointer;">Check-out</label>
              <input type="date" id="checkout_date" class="form-control border-0 p-0 shadow-none text-dark fw-semibold bg-transparent" required>
            </div>
          </div>
          <div class="p-2 border-bottom form-group-custom position-relative" id="guests-dropdown-group">
            <label class="text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem; cursor: pointer;">Guests</label>
            <div class="d-flex justify-content-between align-items-center custom-select-trigger" style="cursor: pointer; padding-top: 2px;">
              <span id="guests-display-val" class="text-dark fw-semibold" style="font-size: 0.9rem;">2 Guests</span>
              <i class="fa-solid fa-chevron-down text-muted" style="font-size: 0.75rem;"></i>
            </div>
            <input type="hidden" name="guests" id="guests-hidden-val" value="2">
            
            <!-- Custom Dropdown Menu -->
            <div class="custom-dropdown-menu d-none shadow" id="guests-options">
              <div class="custom-dropdown-item" data-value="1">1 Guest</div>
              <div class="custom-dropdown-item active" data-value="2">2 Guests</div>
              <div class="custom-dropdown-item" data-value="3">3 Guests</div>
              <div class="custom-dropdown-item" data-value="4">4 Guests</div>
              <div class="custom-dropdown-item" data-value="5">5+ Guests</div>
              <div class="custom-dropdown-item text-secondary border-top" data-value="custom" id="custom-guest-option" style="border-top-style: dashed !important; font-weight: 600;">Custom...</div>
              
              <!-- Custom Input Container (hidden by default) -->
              <div id="custom-guest-input-container" class="d-none px-3 py-2 border-top bg-light">
                <div class="d-flex gap-2 align-items-center">
                  <input type="number" id="custom-guest-input" class="form-control form-control-sm border shadow-sm" min="1" max="100" placeholder="No. of guests" style="font-size: 0.85rem; padding: 4px 8px; width: 110px;">
                  <button type="button" id="custom-guest-apply" class="btn btn-rose btn-sm text-white fw-bold px-3 py-1" style="font-size: 0.75rem; background: #FF385C; border: none; border-radius: 6px;">Apply</button>
                </div>
              </div>
            </div>
          </div>
          <div class="p-2 form-group-custom bg-light position-relative" id="rooms-dropdown-group">
            <label class="text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem; cursor: pointer;">Room Type</label>
            <div class="d-flex justify-content-between align-items-center custom-select-trigger" style="cursor: pointer; padding-top: 2px;">
              <span id="rooms-display-val" class="text-dark fw-semibold" style="font-size: 0.9rem;">Standard Room</span>
              <i class="fa-solid fa-chevron-down text-muted" style="font-size: 0.75rem;"></i>
            </div>
            <input type="hidden" name="room_type" id="rooms-hidden-val" value="Standard Room">
            
            <!-- Custom Dropdown Menu -->
            <div class="custom-dropdown-menu d-none shadow" id="rooms-options">
              <div class="custom-dropdown-item active" data-value="Standard Room" data-extra="0">Standard Room</div>
              <div class="custom-dropdown-item" data-value="Deluxe Room" data-extra="2500">Deluxe Room (+₹2,500)</div>
              <div class="custom-dropdown-item" data-value="Executive Suite" data-extra="6000">Executive Suite (+₹6,000)</div>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-rose rounded-3 w-100 py-3 fw-bold fs-5 text-white mb-3" style="background: linear-gradient(to right, #e61e4d 0%, #e31c5f 50%, #d70466 100%);">
          Reserve
        </button>
      </form>
      
      <div class="text-center">
        <p class="m-0 text-secondary" style="font-size: 0.85rem;">You won't be charged yet</p>
      </div>
      
    </div>
  </div>
</div>

<!-- Image Gallery Modal (Slider) -->
<div class="modal fade" id="imageGalleryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content bg-transparent border-0">
      <div class="modal-header border-0 pb-0 justify-content-end">
        <button type="button" class="btn-close btn-close-white fs-4" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <div id="hotelImageCarousel" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner rounded-4 shadow-lg">
            <% images.forEach((img, idx) => { %>
              <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                <img src="<%= img %>" class="d-block w-100 rounded-4 border border-4 border-white" style="max-height: 80vh; object-fit: contain; background: #000;" alt="Hotel Image">
              </div>
            <% }) %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#hotelImageCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#hotelImageCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="bookingSuccessModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow-lg p-3">
      <div class="modal-body text-center py-5">
        <div class="mb-4">
          <i class="fa-solid fa-circle-check text-success" style="font-size: 5rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-3">Booking Confirmed!</h3>
        <p class="text-secondary mb-4 fs-6">Your reservation at <strong><%= hotel.name %></strong> has been successfully placed. We've sent a confirmation email with your itinerary details.</p>
        <button type="button" class="btn btn-dark rounded-pill px-5 py-2 fw-semibold" data-bs-dismiss="modal">Done</button>
      </div>
    </div>
  </div>
</div>

<!-- Login Required Modal -->
<div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow-lg p-3">
      <div class="modal-header border-0 pb-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center py-4">
        <div class="mb-4">
          <i class="fa-solid fa-lock" style="font-size: 4rem; color: #FF385C;"></i>
        </div>
        <h4 class="fw-bold text-dark mb-3">Please login first</h4>
        <p class="text-secondary mb-4 fs-6">You need to be logged in to your account to book a hotel and manage your reservations.</p>
        <div class="d-grid gap-2">
          <a href="/auth/login-user" class="btn btn-rose rounded-pill py-2 fw-semibold" style="background: #FF385C; color: white;">Log In / Sign Up</a>
          <button type="button" class="btn btn-light border rounded-pill py-2 fw-semibold" data-bs-dismiss="modal">Cancel</button>
        </div>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="/css/hotel-show.css">

<script id="hotel-show-config" type="application/json">
  {
    "currentUser": <%- currentUser ? JSON.stringify(currentUser) : 'null' %>,
    "propertyId": "<%= hotel.propertyId %>",
    "hotelName": <%- JSON.stringify(hotel.name) %>,
    "hotelCity": <%- JSON.stringify(hotel.city) %>,
    "hotelCountry": <%- JSON.stringify(hotel.country || '') %>,
    "hotelArea": <%- JSON.stringify(hotel.area || '') %>,
    "basePrice": <%= price %>,
    "mainImage": "<%= images[0] %>"
  }
</script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const config = JSON.parse(document.getElementById('hotel-show-config').textContent);
    
    // Booking Form Submit Handler
    const bookingForm = document.getElementById('internalBookingForm');
    if (bookingForm) {
      bookingForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        if (!config.currentUser) {
          new bootstrap.Modal(document.getElementById('loginRequiredModal')).show();
          return;
        }
        
        // Show basic loading state
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Booking...';
        submitBtn.disabled = true;
        
        try {
          const priceDisplayEl = document.querySelector('.price-val[data-inr]');
          const currentPriceHTML = priceDisplayEl ? priceDisplayEl.outerHTML : '₹' + config.basePrice;
          const response = await fetch('/api/bookings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              propertyId: config.propertyId,
              name: config.hotelName,
              image: config.mainImage,
              price: currentPriceHTML
            })
          });
          if (response.ok) {
            new bootstrap.Modal(document.getElementById('bookingSuccessModal')).show();
            this.reset();
            
            // Reset selectors
            const guestsHidden = document.getElementById('guests-hidden-val');
            if (guestsHidden) guestsHidden.value = "2";
            const guestsDisplay = document.getElementById('guests-display-val');
            if (guestsDisplay) guestsDisplay.textContent = "2 Guests";
            document.querySelectorAll('#guests-options .custom-dropdown-item').forEach(i => i.classList.remove('active'));
            const defaultGuest = document.querySelector('#guests-options [data-value="2"]');
            if (defaultGuest) defaultGuest.classList.add('active');
            
            const customContainer = document.getElementById('custom-guest-input-container');
            if (customContainer) customContainer.classList.add('d-none');
            const customInput = document.getElementById('custom-guest-input');
            if (customInput) customInput.value = "";
            
            const roomsHidden = document.getElementById('rooms-hidden-val');
            if (roomsHidden) roomsHidden.value = "Standard Room";
            const roomsDisplay = document.getElementById('rooms-display-val');
            if (roomsDisplay) roomsDisplay.textContent = "Standard Room";
            document.querySelectorAll('#rooms-options .custom-dropdown-item').forEach(i => i.classList.remove('active'));
            const defaultRoom = document.querySelector('#rooms-options [data-value="Standard Room"]');
            if (defaultRoom) defaultRoom.classList.add('active');
            
            if (priceDisplayEl) {
              priceDisplayEl.setAttribute('data-inr', config.basePrice);
              if (typeof applyCurrency === 'function') {
                applyCurrency(localStorage.getItem('sv_currency') || 'INR');
              } else {
                priceDisplayEl.textContent = "₹" + config.basePrice.toLocaleString('en-IN');
              }
            }
          } else {
            alert("Failed to confirm booking. Please try again.");
          }
        } catch (err) {
          console.error(err);
        } finally {
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    }



    // Leaflet Interactive Map Load
    const query = (config.hotelArea ? config.hotelArea + ', ' : '') + config.hotelCity + ', ' + config.hotelCountry;
    const map = L.map('map', { scrollWheelZoom: false }).setView([20.5937, 78.9629], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`)
      .then(res => res.json())
      .then(data => {
        if (data && data.length > 0) {
          const lat = parseFloat(data[0].lat);
          const lon = parseFloat(data[0].lon);
          map.setView([lat, lon], 14);
          L.marker([lat, lon]).addTo(map)
            .bindPopup(`<b>${config.hotelName}</b><br>${config.hotelArea ? config.hotelArea + ', ' : ''}${config.hotelCity}`)
            .openPopup();
        } else {
          fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(config.hotelCity + ', ' + config.hotelCountry)}`)
            .then(r => r.json())
            .then(cData => {
              if (cData && cData.length > 0) {
                const lat = parseFloat(cData[0].lat);
                const lon = parseFloat(cData[0].lon);
                map.setView([lat, lon], 12);
                L.marker([lat, lon]).addTo(map)
                  .bindPopup(`<b>${config.hotelName}</b><br>${config.hotelCity}`)
                  .openPopup();
              }
            });
        }
      }).catch(err => console.error("Map load failed", err));

    // Async reviews loader
    const reviewsContainer = document.getElementById('reviewsContainer');
    if (reviewsContainer) {
      const skip = (parseInt(config.propertyId) || 0) % 300;
      fetch(`https://dummyjson.com/comments?limit=4&skip=${skip}`)
        .then(res => res.json())
        .then(data => {
          if (data && data.comments) {
            reviewsContainer.innerHTML = data.comments.map(c => {
              const indianCitiesList = ['goa','mumbai','delhi','jaipur','bangalore','chennai','kolkata','pune','hyderabad','agra','udaipur','kochi','manali','shimla','rishikesh','varanasi','amritsar','gurugram','leh','hospet','hampi','kerala'];
              const foreignCitiesList = ['new york', 'los angeles', 'london', 'dubai', 'paris', 'rome', 'amsterdam', 'tokyo', 'singapore', 'bangkok', 'sydney', 'toronto', 'istanbul', 'cape town', 'rio de janeiro', 'bali', 'santorini', 'maldives', 'phuket', 'swiss alps', 'iceland', 'cappadocia', 'athens', 'venice', 'seoul', 'marrakech', 'reykjavik', 'cairo', 'barcelona'];
              const cLower = (config.hotelCity || '').toLowerCase().trim();
              let isIndian = false;
              if (foreignCitiesList.includes(cLower)) {
                isIndian = false;
              } else if (indianCitiesList.includes(cLower)) {
                isIndian = true;
              } else {
                isIndian = config.hotelCountry ? config.hotelCountry.toLowerCase().trim() === 'india' : false;
              }
              const namesList = isIndian ? 
                ["Rahul Sharma", "Priya Patel", "Amit Kumar", "Neha Gupta", "Vikram Singh", "Anjali Desai", "Rohan Mehta", "Kavita Joshi", "Suresh Iyer", "Pooja Reddy", "Karan Malhotra", "Riya Kapoor", "Aditya Verma", "Sneha Rao", "Aarav Singh", "Ishita Bose", "Rakesh Nair", "Simran Kaur"] :
                ["John Smith", "Emily Johnson", "Carlos Rivera", "Sophie Williams", "Michael Brown", "Emma Davis", "David Miller", "Olivia Garcia", "Daniel Martinez", "Sophia Taylor"];
              
              const nameIndex = c.id || Math.floor(Math.random() * namesList.length);
              const name = namesList[nameIndex % namesList.length];
              const rating = (Math.random() * (5.0 - 4.0) + 4.0).toFixed(1);
              let stars = '';
              for (let i = 1; i <= 5; i++) {
                stars += `<i class="fa-solid fa-star ${i <= Math.round(rating) ? 'text-warning' : 'text-muted opacity-25'}" style="font-size: 0.85rem;"></i>`;
              }
              const date = new Date(Date.now() - Math.floor(Math.random() * 60) * 24 * 60 * 60 * 1000).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
              return `
                <div class="col-md-6">
                  <div class="d-flex align-items-center mb-2">
                    <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 45px; height: 45px; font-size: 1.2rem;">
                      ${name.charAt(0)}
                    </div>
                    <div>
                      <h6 class="fw-bold text-dark mb-0">${name}</h6>
                      <small class="text-muted">${date}</small>
                    </div>
                  </div>
                  <div class="mb-2">${stars}</div>
                  <p class="text-secondary" style="font-size: 0.95rem; line-height: 1.5;">${c.body}</p>
                </div>
              `;
            }).join('');
          }
        }).catch(err => console.error("Reviews load failed", err));
    }
  });
</script>
