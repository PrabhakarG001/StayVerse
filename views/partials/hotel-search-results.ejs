<% if (results && results.length > 0) { %>
  <% results.forEach(entity => { %>
    <%
      const imageUrl = entity.images && entity.images.length > 0 ? entity.images[0] : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=60';
      const seed = parseInt(entity.propertyId) || 12345;
      const priceVal = Math.floor(Math.abs((seed * 9301 + 49297) % 233280) / 233280 * (15000 - 3000 + 1)) + 3000;
      const pricePlain = '₹' + priceVal.toLocaleString('en-IN');
      const rating = entity.reviewScore ? (entity.reviewScore / 2).toFixed(2) : (Math.random() * (5.0 - 4.5) + 4.5).toFixed(2);
      const cardUrl = entity.isListing ? `/listings/${entity.propertyId}` : `/hotels/show/${entity.propertyId}`;
    %>
    <div class="col mb-4">
      <a href="<%= cardUrl %>" class="text-decoration-none text-dark d-block h-100 hotel-card">
        <div class="card border-0 h-100 bg-transparent hotel-card-hover rounded-4 position-relative pb-3 motion-card">
          <div class="position-relative overflow-hidden rounded-4 mb-2" style="aspect-ratio: 1 / 1; width: 100%;">
            <img src="<%= imageUrl %>" class="w-100 h-100 object-fit-cover" alt="Hotel Image" loading="lazy" style="transition: transform 0.4s ease;">
            
            <% if (entity.reviewScore && entity.reviewScore >= 8.5) { %>
              <div class="position-absolute top-0 start-0 m-2 ms-3 mt-3">
                <span class="badge bg-white text-dark shadow-sm px-2 py-1 rounded-pill fw-bold border" style="font-size: 0.75rem;">
                  <i class="fa-solid fa-gem text-rose me-1"></i> Guest favourite
                </span>
              </div>
            <% } %>
            
            <div class="position-absolute top-0 end-0 m-3" style="z-index: 10;">
              <i class="fa-regular fa-heart fs-5 text-white heart-wishlist-icon" 
                 data-id="<%= entity.propertyId %>" 
                 style="text-shadow: 0 1px 3px rgba(0,0,0,0.5); cursor: pointer;" 
                 onclick="toggleWishlist(event, '<%= entity.propertyId %>', '<%= entity.name.replace(/'/g, '&apos;') %>', '<%= entity.city.replace(/'/g, '&apos;') %>', '<%= pricePlain %>', '<%= rating %>', '<%= imageUrl %>', false)"></i>
            </div>
            
            <div class="image-nav-arrow-overlay">
              <i class="fa-solid fa-arrow-right"></i>
            </div>
          </div>
          <div class="pt-1 pe-1">
            <div class="d-flex justify-content-between align-items-start mb-1">
              <h6 class="fw-bold text-dark mb-0 pe-2 text-truncate" style="font-size: 0.98rem; line-height: 1.3; max-width: 85%;"><%= entity.name %></h6>
              <div class="ms-1 d-flex align-items-center flex-shrink-0 mt-1">
                <i class="fa-solid fa-star me-1" style="font-size: 0.75rem; color: #222;"></i>
                <span style="font-size: 0.9rem; color: #222; font-weight: 600;"><%= rating %></span>
              </div>
            </div>
            <p class="text-secondary mb-1 text-truncate" style="font-size: 0.9rem; line-height: 1.4;"><%= entity.area ? entity.area + ', ' : '' %><%= entity.city %></p>
            <div class="d-flex align-items-center mt-1 pb-1">
              <span class="text-dark"><span class="price-val fw-bold" data-inr="<%= priceVal %>">₹<%= priceVal.toLocaleString('en-IN') %></span> <span class="fw-normal text-muted" style="font-size: 0.8rem;">night</span></span>
              <span class="text-dark" style="font-size: 0.9rem;">&nbsp;for 2 nights</span>
            </div>
          </div>
        </div>
      </a>
    </div>
  <% }) %>
<% } %>
