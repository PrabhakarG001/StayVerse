        <h5 class="offcanvas-title fw-bold text-dark" id="mobileSidebarLabel" style="color: #FF385C !important;">StayVerse</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body p-0">
        <div class="list-group list-group-flush border-0">
          <a href="/" class="list-group-item list-group-item-action py-3 fw-semibold border-0"><i class="fa-solid fa-house me-3 text-secondary"></i>Home</a>
          <a href="/wishlists" class="list-group-item list-group-item-action py-3 fw-semibold border-0"><i class="fa-solid fa-heart me-3 text-secondary"></i>Wishlists</a>
          <% if(!currentUser) { %>
            <a href="/auth/login-host" class="list-group-item list-group-item-action py-3 fw-semibold border-0"><i class="fa-solid fa-house-user me-3 text-secondary"></i>Become a Host</a>
            <a href="/auth/login-user" class="list-group-item list-group-item-action py-3 fw-semibold border-0"><i class="fa-solid fa-right-to-bracket me-3 text-secondary"></i>Login / Sign up</a>
          <% } else if (currentUser.role === 'user') { %>
            <a href="/my-bookings" class="list-group-item list-group-item-action py-3 fw-semibold border-0"><i class="fa-solid fa-suitcase-rolling me-3 text-secondary"></i>My Booking</a>
            <a href="/auth/logout" class="list-group-item list-group-item-action py-3 fw-semibold border-0 text-danger"><i class="fa-solid fa-right-from-bracket me-3"></i>Log out</a>
          <% } else if (currentUser.role === 'host') { %>
            <a href="/my-host" class="list-group-item list-group-item-action py-3 fw-semibold border-0"><i class="fa-solid fa-house-medical me-3 text-secondary"></i>My Host</a>
            <a href="/listings/new" class="list-group-item list-group-item-action py-3 fw-semibold border-0"><i class="fa-solid fa-plus me-3 text-secondary"></i>Create Listing</a>
            <a href="/auth/logout" class="list-group-item list-group-item-action py-3 fw-semibold border-0 text-danger"><i class="fa-solid fa-right-from-bracket me-3"></i>Log out</a>
          <% } %>
        </div>
      </div>
    </div>

    <% if (typeof hideSearch === 'undefined' || !hideSearch) { %>
    <div class="sv-booking-bar-container d-none d-md-flex" style="position: relative;">
      <div id="sv-booking-bar"></div>
    </div>
    <% } %>
  </div>
</header>

