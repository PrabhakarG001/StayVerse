        <a href="/listings?filter=india" class="d-flex align-items-center text-decoration-none rounded-pill sv-cat-pill motion-nav-item <%= currentFilter === 'india' ? 'active-pill text-dark' : 'text-secondary' %>" style="padding: 10px 20px; gap: 10px; min-width: max-content; margin-left: 4px;">
