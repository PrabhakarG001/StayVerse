          <span class="<%= currentFilter === 'india' ? 'fw-bold' : 'fw-semibold' %>" style="font-size: 0.9rem;">India</span>
        </a>
        <a href="/listings?filter=foreign" class="d-flex align-items-center text-decoration-none rounded-pill sv-cat-pill motion-nav-item <%= currentFilter === 'foreign' ? 'active-pill text-dark' : 'text-secondary' %>" style="padding: 10px 20px; gap: 10px; min-width: max-content; margin-left: 4px;">
          <img src="/images/cat_foreign.png" alt="Foreign" style="width: 20px; height: 20px; opacity: <%= currentFilter === 'foreign' ? '1' : '0.6' %>;">
          <span class="<%= currentFilter === 'foreign' ? 'fw-bold' : 'fw-semibold' %>" style="font-size: 0.9rem;">Foreign</span>
        </a>
