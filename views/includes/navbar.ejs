<script>
  // Search Submit Handler
  function handleSearch(e) {
    return true;
  }



  // Scroll Logic for navbar
  window.addEventListener('scroll', function() {
    const header = document.getElementById('sv-header');
    const destPopup = document.getElementById('sv-dest-popup');
    const whereBtn = document.getElementById('sv-where-btn');
    const whereInput = document.getElementById('sv-where-input');
    
    if(window.scrollY > 50) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });

  // Close offcanvas menu when clicking links
  document.querySelectorAll('#mobileSidebar .list-group-item').forEach(link => {
    link.addEventListener('click', () => {
      const bsOffcanvas = bootstrap.Offcanvas.getInstance(document.getElementById('mobileSidebar'));
      if (bsOffcanvas) bsOffcanvas.hide();
    });
  });
</script>
