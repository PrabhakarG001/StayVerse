<!-- ===================== STAYVERSE FOOTER (Airbnb-style) ===================== -->
<style>
  /* ── Footer Reset & Base ── */
  .sv-footer {
    background-color: #f7f7f7;
    border-top: 1px solid #ddd;
    font-family: inherit;
    color: #222;
  }

  /* ── Inspiration / Destinations Section ── */
  .sv-footer-inspiration {
    padding: 48px 0 0;
    border-bottom: 1px solid #ddd;
  }
  .sv-footer-inspiration h4 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #222;
    margin-bottom: 24px;
  }

  /* Tab navigation for destinations */
  .sv-dest-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid #ddd;
    margin-bottom: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .sv-dest-tabs::-webkit-scrollbar { display: none; }

  .sv-dest-tab {
    padding: 12px 16px;
    font-size: 0.88rem;
    font-weight: 500;
    color: #717171;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: all 0.2s ease;
    cursor: pointer;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    flex-shrink: 0;
  }
  .sv-dest-tab:hover {
    color: #222;
  }
  .sv-dest-tab.active {
    color: #222;
    font-weight: 600;
    border-bottom-color: #222;
  }

  /* Destination grid */
  .sv-dest-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
    padding: 24px 0 32px;
  }
  .sv-dest-card {
    padding: 12px 16px 12px 0;
  }
  .sv-dest-card a {
    text-decoration: none;
    display: block;
  }
  .sv-dest-card .dest-city {
    font-size: 0.88rem;
    font-weight: 600;
    color: #222;
    line-height: 1.3;
  }
  .sv-dest-card .dest-type {
    font-size: 0.82rem;
    color: #717171;
    font-weight: 400;
    margin-top: 2px;
  }
  .sv-dest-card a:hover .dest-city {
    text-decoration: underline;
  }

  /* Show more toggle */
  .sv-show-more-btn {
    background: none;
    border: none;
    font-size: 0.88rem;
    font-weight: 600;
    color: #222;
    cursor: pointer;
    padding: 0 0 24px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
  }
  .sv-show-more-btn:hover {
    text-decoration: underline;
  }
  .sv-show-more-btn i {
    font-size: 0.7rem;
    transition: transform 0.3s ease;
  }
  .sv-show-more-btn.expanded i {
    transform: rotate(180deg);
  }

  /* ── Four-Column Links Section ── */
  .sv-footer-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 48px 0;
    border-bottom: 1px solid #ddd;
  }
  .sv-footer-col {
    padding-right: 24px;
  }
  .sv-footer-col:not(:last-child) {
    border-right: 1px solid #ddd;
    padding-right: 48px;
  }
  .sv-footer-col:not(:first-child) {
    padding-left: 48px;
  }
  .sv-footer-col h5 {
    font-size: 0.82rem;
    font-weight: 700;
    color: #222;
    text-transform: capitalize;
    margin-bottom: 16px;
    letter-spacing: 0;
  }
  .sv-footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sv-footer-col ul li a {
    font-size: 0.86rem;
    color: #222;
    text-decoration: none;
    font-weight: 400;
    transition: text-decoration 0.15s ease;
    line-height: 1.4;
  }
  .sv-footer-col ul li a:hover {
    color: #FF385C;
    text-decoration: none;
  }

  /* ── Bottom Bar ── */
  .sv-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    flex-wrap: wrap;
    gap: 16px;
  }
  .sv-footer-bottom-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.82rem;
    color: #717171;
  }
  .sv-footer-bottom-left a {
    color: #222;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 400;
    transition: text-decoration 0.15s;
  }
  .sv-footer-bottom-left a:hover {
    text-decoration: underline;
  }
  .sv-footer-bottom-left .dot {
    color: #717171;
    font-size: 0.5rem;
    line-height: 1;
  }

  .sv-footer-bottom-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .sv-footer-lang-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    font-size: 0.86rem;
    font-weight: 600;
    color: #222;
    cursor: pointer;
    padding: 0;
    text-decoration: none;
    transition: text-decoration 0.15s;
  }
  .sv-footer-lang-btn:hover {
    text-decoration: underline;
  }
  .sv-footer-lang-btn i {
    font-size: 1rem;
  }

  .sv-footer-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .sv-footer-socials a {
    color: #222;
    font-size: 1.1rem;
    transition: color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }
  .sv-footer-socials a:hover {
    color: #FF385C;
    transform: scale(1.15);
  }

  /* ── Mobile Accordion for Links ── */
  @media (max-width: 750px) {
    .sv-footer-links {
      grid-template-columns: 1fr;
      padding: 0;
      gap: 0;
    }
    .sv-footer-col {
      padding: 0 !important;
      border-right: none !important;
      border-bottom: 1px solid #ddd;
    }
    .sv-footer-col:first-child {
      padding: 24px 0 !important;
    }
    .sv-footer-col:last-child {
      border-bottom: none;
    }
    .sv-footer-col h5 {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
      margin-bottom: 0;
      cursor: pointer;
      font-size: 0.88rem;
    }
    .sv-footer-col h5::after {
      content: '\f107';
      font-family: 'Font Awesome 6 Free';
      font-weight: 900;
      font-size: 0.75rem;
      color: #717171;
      transition: transform 0.3s ease;
    }
    .sv-footer-col.open h5::after {
      transform: rotate(180deg);
    }
    .sv-footer-col ul {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, padding 0.35s ease;
      padding-bottom: 0;
    }
    .sv-footer-col.open ul {
      max-height: 300px;
      padding-bottom: 20px;
    }

    /* Destination grid responsive */
    .sv-dest-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Bottom bar stacks */
    .sv-footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .sv-footer-bottom-left {
      justify-content: center;
    }
    .sv-footer-bottom-right {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  @media (min-width: 768px) and (max-width: 991.98px) {
    .sv-dest-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .sv-footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .sv-footer-col:not(:last-child) {
      padding-right: 0;
      border-right: none;
    }
    .sv-footer-col:not(:first-child) {
      padding-left: 0;
    }
  }
</style>

