</footer>

<script>
  // ── Dynamic Destination Grid JS ──
  const categoryMap = {
    beach: ["goa", "bali", "maldives", "phuket", "andaman", "santorini", "pondicherry", "busan", "dubrovnik"],
    mountain: ["manali", "shimla", "darjeeling", "swiss alps", "leh-ladakh", "mussoorie", "spiti", "dharamshala", "queenstown"],
    heritage: ["jaipur", "varanasi", "rome", "agra", "athens", "hampi", "kyoto", "lisbon"],
    unique: ["jaisalmer", "coorg", "iceland", "wayanad", "cappadocia", "shillong"],
    romantic: ["paris", "udaipur", "venice", "alleppey", "santorini", "ooty", "marrakech", "kyoto"],
    popular: ["goa", "manali", "jaipur", "bali", "paris", "udaipur", "tokyo", "kerala", "maldives", "shimla", "kyoto", "santorini", "queenstown", "lisbon", "marrakech"]
  };

  let fetchedCities = [];
  let currentActiveTab = 'all';
  let isGridExpanded = false;

  async function loadDynamicCities() {
    try {
      const res = await fetch('/api/destinations');
      const data = await res.json();
      fetchedCities = data.cities || [];
      renderDestinations(currentActiveTab);
    } catch (err) {
      console.error("Failed to load cities for footer", err);
    }
  }

  function getCitiesForTab(tab) {
    if (tab === 'all') return fetchedCities;
    const tabList = categoryMap[tab] || [];
    return fetchedCities.filter(c => tabList.includes(c.toLowerCase()));
  }

  function getSubText(city, tab) {
    if (tab === 'beach') return "Coastal getaway";
    if (tab === 'mountain') return "Mountain retreat";
    if (tab === 'heritage') return "Culture & History";
    if (tab === 'unique') return "Unique stay";
    if (tab === 'romantic') return "Romantic escape";
    return "Explore destination"; // Default for all/popular
  }

  function renderDestinations(tab) {
    const grid = document.getElementById('sv-dynamic-grid');
    const showMoreBtn = document.getElementById('sv-dynamic-show-more');
    grid.innerHTML = '';
    
    const citiesToRender = getCitiesForTab(tab);
    
    if (citiesToRender.length === 0) {
      grid.innerHTML = '<div style="grid-column: span 6; padding: 20px 0; color: #717171;">No destinations available in this category yet.</div>';
      showMoreBtn.style.display = 'none';
      return;
    }

    citiesToRender.forEach((city, index) => {
      const isExtra = index >= 12;
      const displayStyle = (isExtra && !isGridExpanded) ? 'display: none;' : '';
      
      grid.innerHTML += `
        <div class="sv-dest-card" style="${displayStyle}">
          <a href="/hotels/search?query=${encodeURIComponent(city)}">
            <div class="dest-city">${city}</div>
            <div class="dest-type">${getSubText(city, tab)}</div>
          </a>
        </div>
      `;
    });

    if (citiesToRender.length > 12) {
      showMoreBtn.style.display = 'inline-flex';
      showMoreBtn.innerHTML = isGridExpanded 
        ? 'Show less <i class="fa-solid fa-chevron-up"></i>'
        : 'Show more <i class="fa-solid fa-chevron-down"></i>';
    } else {
      showMoreBtn.style.display = 'none';
    }
  }

  function toggleDynamicDestinations() {
    isGridExpanded = !isGridExpanded;
    renderDestinations(currentActiveTab);
  }

  document.addEventListener("DOMContentLoaded", () => {
    loadDynamicCities();
    
    document.querySelectorAll('.sv-dest-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.sv-dest-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        currentActiveTab = this.getAttribute('data-tab');
        isGridExpanded = false;
        renderDestinations(currentActiveTab);
      });
    });
  });

  // ── Mobile accordion for footer columns ──
  function toggleFooterCol(h5) {
    if (window.innerWidth >= 768) return; // Only on mobile
    const col = h5.parentElement;
    col.classList.toggle('open');
  }
</script>