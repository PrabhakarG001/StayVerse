<% layout("/layouts/boilerplate") %>

<style>
  /* Hide the navbar search elements on the dedicated search page to avoid confusion */
  .sv-header-row2, .sv-compact-pill { display: none !important; }
  .sv-header-row1 { padding-bottom: 16px !important; }

  .hotel-search-container {
    padding: 2rem 0;
  }
  .search-hero {
    background: linear-gradient(135deg, #fe424d 0%, #ff7e82 100%);
    border-radius: 1rem;
    padding: 3rem;
    color: white;
    margin-bottom: 2rem;
    text-align: center;
    box-shadow: 0 10px 30px rgba(254, 66, 77, 0.2);
  }
  .search-hero h1 {
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .search-input-group {
    max-width: 600px;
    margin: 0 auto;
    background: white;
    border-radius: 50px;
    padding: 0.5rem;
    display: flex;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  }
  .search-input-group input {
    border: none;
    border-radius: 50px;
    padding: 0.75rem 1.5rem;
    flex-grow: 1;
    font-size: 1.1rem;
  }
  .search-input-group input:focus {
    outline: none;
    box-shadow: none;
  }
  .search-input-group button {
    border-radius: 50px;
    padding: 0.75rem 2rem;
    background-color: #fe424d;
    border: none;
    color: white;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  .search-input-group button:hover {
    background-color: #e03540;
  }
  @media (max-width: 575.98px) {
    .search-hero { padding: 1.5rem 1rem; }
    .search-hero h1 { font-size: 1.5rem; }
    .search-input-group { flex-direction: column; border-radius: 0; background: transparent; box-shadow: none; padding: 0; }
    .search-input-group input { border-radius: 12px; margin-bottom: 10px; width: 100%; padding: 0.75rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .search-input-group button { border-radius: 12px; width: 100%; }
  }
  /* Internal Card Hover */
  .hotel-card-hover {
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .hotel-card-hover:hover {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 15px 35px rgba(255, 56, 92, 0.12) !important;
  }
  .heart-wishlist-icon {
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .heart-wishlist-icon:hover {
    transform: scale(1.2);
  }
  @keyframes bounce-subtle {
    0%, 100% { transform: translateY(0) translateX(-50%); }
    50% { transform: translateY(4px) translateX(-50%); }
  }
  @keyframes bounce-fast {
    0%, 100% { transform: translateY(2px) translateX(-50%); }
    50% { transform: translateY(6px) translateX(-50%); }
  }
  .scroll-indicator {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: #222;
    opacity: 0.75;
    animation: bounce-subtle 1.5s infinite ease-in-out;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .hotel-card-hover:hover .scroll-indicator {
    opacity: 1;
    animation: bounce-fast 0.8s infinite ease-in-out;
  }
  .hotel-icon-wrapper {
    background: #f8f9fa;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fe424d;
    font-size: 3rem;
  }
  .loader {
    display: none;
    text-align: center;
    padding: 2rem;
  }
  .spinner-border {
    color: #fe424d;
  }
  @media (min-width: 1400px) {
    .row-cols-xxl-7 > * {
      flex: 0 0 auto;
      width: 14.285714%;
    }
  }
</style>

<div class="hotel-search-container">
  <div class="search-hero">
    <h1>Find Real Places Worldwide</h1>
    <p class="lead mb-4" style="font-size: 0.95rem;">Discover cities, neighborhoods, and hotels directly from StayVerse</p>
    
    <form id="hotelSearchForm" class="search-input-group">
      <input type="text" id="hotelQuery" placeholder="e.g. Mumbai, New Delhi, India..." required>
      <button type="submit">
        <i class="fa-solid fa-magnifying-glass me-2"></i> Search
      </button>
    </form>
  </div>

  <div class="loader" id="searchLoader">
    <div class="spinner-border" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
    <p class="mt-2 text-secondary">Fetching real data...</p>
  </div>

  <div id="resultsContainer" class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-7 g-2 g-md-4">
    <!-- Results will be injected here -->
  </div>
  
  <div id="emptyState" class="text-center py-5 d-none">
    <i class="fa-solid fa-map-location-dot fs-1 text-muted mb-3"></i>
    <h4>No places found</h4>
    <p class="text-secondary">Try searching for a different location.</p>
  </div>

  <!-- StayAPI Meta Booking Modal -->
  <div class="modal fade" id="metaBookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-4 shadow-lg">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="metaModalTitle">Booking Options</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center pt-2 pb-4">
          <p class="text-muted small mb-4" id="metaModalLocation">Loading booking options...</p>
          
          <div id="metaModalLoader" class="py-4">
            <div class="spinner-border text-danger" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 mb-0 text-secondary small">Searching multiple platforms...</p>
          </div>

          <div id="metaModalLinks" class="d-none d-flex flex-column gap-3">
            <!-- Dynamically inserted links -->
          </div>
          
          <div id="metaModalError" class="d-none py-3">
            <i class="fa-solid fa-circle-exclamation text-danger fs-3 mb-2"></i>
            <p class="text-secondary small mb-3">Could not find alternative booking links.</p>
            <a id="metaModalFallbackLink" href="#" target="_blank" class="btn btn-outline-danger w-100 rounded-pill">Continue to Agoda</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  async function performSearch(query) {
    const loader = document.getElementById('searchLoader');
    const resultsContainer = document.getElementById('resultsContainer');
    const emptyState = document.getElementById('emptyState');

    // Reset UI
    resultsContainer.innerHTML = '';
    emptyState.classList.add('d-none');
    loader.style.display = 'block';

    try {
      const response = await fetch(`/api/hotels/search?q=${encodeURIComponent(query)}`);
      const data = await response.json();
      
      loader.style.display = 'none';

      if (!data || !data.searchResults || data.searchResults.length === 0) {
        emptyState.classList.remove('d-none');
        return;
      }

      const getMockPrice = (propertyId) => {
        const seed = parseInt(propertyId) || 12345;
        const price = Math.floor(Math.abs((seed * 9301 + 49297) % 233280) / 233280 * (15000 - 3000 + 1)) + 3000;
        return `₹${price.toLocaleString('en-IN')}`;
      };

      data.searchResults.forEach(entity => {
        const col = document.createElement('div');
        col.className = 'col mb-4';
        
        const imageUrl = entity.images && entity.images.length > 0 ? entity.images[0] : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=60';
        const price = getMockPrice(entity.propertyId);
        const rating = entity.reviewScore ? (entity.reviewScore / 2).toFixed(2) : (Math.random() * (5.0 - 4.5) + 4.5).toFixed(2);
        
        const propTypeRaw = entity.accommodationType || entity.propertyType || 'Hotel';
        let propType = typeof propTypeRaw === 'object' ? (propTypeRaw.name || 'Hotel') : propTypeRaw;
        if (propType.toLowerCase() === 'apartment') propType = 'Flat';
        
        let badgeHtml = '';
        if (entity.reviewScore && entity.reviewScore >= 8.5) {
          badgeHtml = `
            <div class="position-absolute top-0 start-0 m-2 ms-3 mt-3">
              <span class="badge bg-white text-dark shadow-sm px-2 py-1 rounded-pill fw-bold border" style="font-size: 0.75rem;">
                <i class="fa-solid fa-gem text-rose me-1"></i> Guest favourite
              </span>
            </div>
          `;
        }
        
        col.innerHTML = `
          <a href="/hotels/show/${entity.propertyId}" class="text-decoration-none text-dark d-block h-100 hotel-card">
            <div class="card border-0 h-100 bg-transparent hotel-card-hover rounded-4 position-relative pb-3">
              <div class="position-relative overflow-hidden rounded-4 mb-2" style="aspect-ratio: 1 / 1; width: 100%;">
                <img src="${imageUrl}" class="w-100 h-100 object-fit-cover" alt="Hotel Image" loading="lazy">
                
                ${badgeHtml}
                
                <div class="position-absolute top-0 end-0 m-3" style="z-index: 10;">
                  <i class="fa-regular fa-heart fs-5 text-white heart-wishlist-icon" 
                     data-id="${entity.propertyId}" 
                     style="text-shadow: 0 1px 3px rgba(0,0,0,0.5); cursor: pointer;" 
                     onclick="toggleWishlist(event, '${entity.propertyId}', '${entity.name.replace(/'/g, "&apos;")}', '${entity.city.replace(/'/g, "&apos;")}', '${price}', '${rating}', '${imageUrl}', false)"></i>
                </div>
              </div>
              <div class="pt-1 pe-1">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <h6 class="fw-bold text-dark mb-0 pe-2 text-truncate" style="font-size: 0.98rem; line-height: 1.3; max-width: 85%;">${entity.name}</h6>
                  <div class="ms-1 d-flex align-items-center flex-shrink-0 mt-1">
                    <i class="fa-solid fa-star me-1" style="font-size: 0.75rem; color: #222;"></i>
                    <span style="font-size: 0.9rem; color: #222; font-weight: 600;">${rating}</span>
                  </div>
                </div>
                <p class="text-secondary mb-1 text-truncate" style="font-size: 0.9rem; line-height: 1.4;">${entity.area ? entity.area + ', ' : ''}${entity.city}</p>
                <div class="d-flex align-items-center mt-1 pb-1">
                  <span class="fw-bold text-dark" style="font-size: 0.98rem;">${price}</span>
                  <span class="text-dark" style="font-size: 0.9rem;">&nbsp;for 2 nights</span>
                </div>
              </div>
              <i class="fa-solid fa-chevron-down scroll-indicator"></i>
            </div>
          </a>
        `;
        resultsContainer.appendChild(col);
      });
      
      // Re-initialize wishlist hearts if necessary
      if (typeof getWishlists === 'function') {
        const wishlists = getWishlists();
        const wishlistIds = new Set(wishlists.map(h => h.propertyId.toString()));
        document.querySelectorAll('.heart-wishlist-icon').forEach(icon => {
          const propertyId = icon.getAttribute('data-id');
          if (wishlistIds.has(propertyId.toString())) {
            icon.classList.replace('fa-regular', 'fa-solid');
            icon.classList.remove('text-white');
            icon.classList.add('text-danger');
          }
        });
      }

    } catch (error) {
      console.error("Error fetching hotel data:", error);
      loader.style.display = 'none';
      emptyState.innerHTML = `
        <i class="fa-solid fa-triangle-exclamation fs-1 text-danger mb-3"></i>
        <h4>Something went wrong</h4>
        <p class="text-secondary">Failed to load data. Please check console for details.</p>
      `;
      emptyState.classList.remove('d-none');
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const passedQuery = "<%= typeof query !== 'undefined' ? query : '' %>";
    if (passedQuery) {
      document.getElementById('hotelQuery').value = passedQuery;
      performSearch(passedQuery);
    }
  });

  document.getElementById('hotelSearchForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const query = document.getElementById('hotelQuery').value;
    performSearch(query);
  });

  // StayAPI Modal Logic
  let metaModalInstance = null;
  
  window.openMetaModal = async (hotelName, location, fallbackAgodaUrl) => {
    if (!metaModalInstance) {
      metaModalInstance = new bootstrap.Modal(document.getElementById('metaBookingModal'));
    }
    
    document.getElementById('metaModalTitle').textContent = hotelName;
    document.getElementById('metaModalLocation').textContent = location;
    
    document.getElementById('metaModalLoader').classList.remove('d-none');
    document.getElementById('metaModalLinks').classList.add('d-none');
    document.getElementById('metaModalError').classList.add('d-none');
    
    metaModalInstance.show();

    try {
      const response = await fetch(`/api/hotels/meta?hotel_name=${encodeURIComponent(hotelName)}&location=${encodeURIComponent(location)}`);
      const data = await response.json();
      
      document.getElementById('metaModalLoader').classList.add('d-none');
      
      if (data.success && data.links && Object.keys(data.links).length > 0) {
        const linksContainer = document.getElementById('metaModalLinks');
        linksContainer.innerHTML = '';
        
        // Always add Agoda fallback at the top just in case
        linksContainer.innerHTML += `
          <a href="${fallbackAgodaUrl}" target="_blank" class="btn btn-outline-danger rounded-pill w-100 text-start px-4 py-2 d-flex justify-content-between align-items-center">
            <span class="fw-bold">Agoda</span>
            <i class="fa-solid fa-arrow-up-right-from-square small"></i>
          </a>
        `;
        
        Object.entries(data.links).forEach(([platform, url]) => {
          const platformName = platform.charAt(0).toUpperCase() + platform.slice(1).replace('_', ' ');
          linksContainer.innerHTML += `
            <a href="${url}" target="_blank" class="btn btn-dark rounded-pill w-100 text-start px-4 py-2 d-flex justify-content-between align-items-center">
              <span class="fw-bold">${platformName}</span>
              <i class="fa-solid fa-arrow-up-right-from-square small"></i>
            </a>
          `;
        });
        
        linksContainer.classList.remove('d-none');
      } else {
        throw new Error("No links found");
      }
    } catch (err) {
      console.error("StayAPI Error:", err);
      document.getElementById('metaModalLoader').classList.add('d-none');
      document.getElementById('metaModalFallbackLink').href = fallbackAgodaUrl;
      document.getElementById('metaModalError').classList.remove('d-none');
    }
  };
</script>
