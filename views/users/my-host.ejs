<% layout('layouts/boilerplate') %>

<style>
  .hotel-card-hover {
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .hotel-card-hover:hover {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 15px 35px rgba(255, 56, 92, 0.12) !important;
  }
  .wishlist-empty {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .wishlist-empty i {
    font-size: 4rem;
    color: #FF385C;
    margin-bottom: 20px;
    opacity: 0.8;
  }
</style>

<div class="container mt-5 mb-5 px-4" style="max-width: 1400px;">
  <h2 class="fw-bold mb-4" style="font-size: 2rem;">My Hosted Listings</h2>
  
  <% if (!listings || listings.length === 0) { %>
    <div id="empty-state" class="wishlist-empty">
      <i class="fa-solid fa-house-medical"></i>
      <h3 class="fw-bold">No listings yet</h3>
      <p class="text-secondary mt-2 mb-4">Start hosting and earning extra income by creating your first listing.</p>
      <a href="/listings/new" class="btn btn-rose text-white fw-bold px-4 py-3" style="border-radius: 12px; font-size: 1.1rem;">Create Listing</a>
    </div>
  <% } else { %>
    <div class="mb-4">
      <a href="/listings/new" class="btn btn-outline-dark rounded-pill fw-bold"><i class="fa-solid fa-plus me-2"></i>Create New Listing</a>
    </div>
    <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
      <% listings.forEach(listing => { %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark d-block h-100 hotel-card">
            <div class="card border-0 h-100 bg-transparent hotel-card-hover rounded-4 position-relative pb-3">
              <div class="position-relative overflow-hidden rounded-4 mb-2" style="aspect-ratio: 1 / 1; width: 100%;">
                <img src="<%= (listing.images && listing.images.length > 0) ? listing.images[0].url : (listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80') %>" class="w-100 h-100 object-fit-cover" alt="Listing Image" loading="lazy">
                
                <div class="position-absolute top-0 end-0 m-3" style="z-index: 10;">
                  <span class="badge bg-white text-dark rounded-pill fw-bold shadow-sm" style="font-size: 0.75rem;"><i class="fa-solid fa-star text-warning me-1"></i><%= listing.reviews ? listing.reviews.length : 0 %> Reviews</span>
                </div>
              </div>
              <div class="pt-1 pe-1">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <h6 class="fw-bold text-dark mb-0 pe-2 text-truncate" style="font-size: 0.98rem; line-height: 1.3; max-width: 85%;"><%= listing.title %></h6>
                </div>
                <p class="text-secondary mb-1 text-truncate" style="font-size: 0.9rem; line-height: 1.4;"><%= listing.location %>, <%= listing.country %></p>
                <div class="d-flex align-items-center mt-1 pb-1">
                  <span class="fw-bold text-dark" style="font-size: 0.98rem;">Rs. <%= listing.price ? listing.price.toLocaleString('en-IN') : '0' %></span>
                  <span class="text-dark" style="font-size: 0.9rem;">&nbsp;/ night</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
