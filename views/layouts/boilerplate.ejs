<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StayVerse | Perfect Stays</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- FontAwesome for Premium Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <!-- Google Fonts: Plus Jakarta Sans & Outfit & Audiowide -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Audiowide&display=swap" rel="stylesheet">
  
  <!-- Leaflet Map CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  
  <!-- Custom Stylesheets -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Booking Search Bar -->
  <link rel="stylesheet" href="/css/searchbar.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/wishlist.css">
  <link rel="stylesheet" href="/css/boilerplate.css">
  
  <!-- Leaflet Map JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <!-- Motion Initial States & Instant CSS Animations -->
  <link rel="modulepreload" href="https://cdn.jsdelivr.net/npm/motion@11.11.17/+esm">
  <script>document.documentElement.classList.add('js-enabled');</script>
</head>
<body data-logged-in="<%= currentUser ? 'true' : 'false' %>">
  <%- include("../partials/navbar.ejs") %>
  
  <main class="container-fluid px-4 px-lg-5 mb-4 mt-4 mt-md-5 pt-md-4">
    <%- body %>
  </main>
  
  <%- include("../partials/footer.ejs") %>

  <!-- Google Translate Hidden Widget -->
  <div id="google_translate_element" style="display:none;"></div>
  
  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- StayVerse Core Hybrid Scripts -->
  <script src="/js/main.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/search.js"></script>
  <script src="/js/auth.js"></script>
  <script type="module" src="/js/animations.js"></script>
  <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  
  <div class="mobile-bottom-nav d-md-none">
    <a href="/" class="<%= (typeof page !== 'undefined' && page === 'home') ? 'active' : '' %>">
      <i class="fa-solid fa-magnifying-glass"></i>
      <span>Explore</span>
    </a>
    <a href="javascript:void(0)" onclick="handleProtectedAction(function(){ window.location.href='/wishlists' })" class="<%= (typeof page !== 'undefined' && page === 'wishlists') ? 'active' : '' %>">
        <i class="fa-regular fa-heart"></i>
        <span>Wishlists</span>
    </a>
    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'host') { %>
      <a href="/my-host" class="<%= (typeof page !== 'undefined' && page === 'my-host') ? 'active' : '' %>">
        <i class="fa-solid fa-house-medical"></i>
        <span>My Host</span>
      </a>
    <% } else { %>
      <a href="javascript:void(0)" onclick="handleProtectedAction(function(){ window.location.href='/my-bookings?tab=past' })" class="<%= (typeof page !== 'undefined' && page === 'bookings') ? 'active' : '' %>">
        <i class="fa-solid fa-suitcase-rolling"></i>
        <span>Past Trips</span>
      </a>
    <% } %>
    <a href="javascript:void(0)" onclick="handleProtectedRoute('/messages')" class="<%= (typeof page !== 'undefined' && page === 'messages') ? 'active' : '' %>">
      <i class="fa-regular fa-message"></i>
      <span>Messages</span>
    </a>
    <% if(!currentUser) { %>
      <a href="/login">
        <i class="fa-regular fa-circle-user"></i>
        <span>Log in</span>
      </a>
    <% } else { %>
      <a href="/profile">
        <div class="profile-avatar-small" style="width: 24px; height: 24px; border-radius: 50%; background-color: #717171; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; margin: 0 auto 4px auto;">
          <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <span>Profile</span>
      </a>
    <% } %>
  </div>

  <!-- Global Scroll Progress Indicator -->
  <div class="sv-scroll-progress-container">
    <div class="sv-scroll-progress-bar"></div>
  </div>
</body>
</html>
